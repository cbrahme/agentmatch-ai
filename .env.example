# ==============================================================================
# AgentMatch AI - Environment Configuration
# ==============================================================================

# Operation Mode
# Set to true to run offline against mock/cached data without needing live external services
SAMPLE_MODE=true

# ------------------------------------------------------------------------------
# Zetaris Data Layer (Local Docker or Managed Cloud)
# ------------------------------------------------------------------------------
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=1
ZETARIS_API_KEY=your_zetaris_api_key_here

# ------------------------------------------------------------------------------
# Meterless Nightshift / AI Provider Configuration
# ------------------------------------------------------------------------------
MODEL_BASE_URL=http://localhost:8000/v1
MODEL_API_KEY=your_meterless_or_model_api_key_here
NEMOTRON_MODEL=nvidia/nemotron-4-340b-instruct

# ------------------------------------------------------------------------------
# Fallback LLM Providers (Optional)
# ------------------------------------------------------------------------------
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
